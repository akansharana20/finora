{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "apps/api/src/**",
          "apps/api/prisma/**",
          "prisma/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "api/index.ts"
    },
    {
      "src": "/health",
      "dest": "api/index.ts"
    },
    {
      "src": "/api/auth(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/api/customers(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/api/suppliers(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/api/invoices(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/api/expenses(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/api/payments(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/api/vat(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/api/hmrc(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/api/xero(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/api/reports(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/api/audit(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/api/firms(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/api(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ]
}

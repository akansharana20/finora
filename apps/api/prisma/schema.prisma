datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  ACCOUNTANT
  USER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum ExpensePaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum VatObligationStatus {
  OPEN
  FULFILLED
}

enum VatReturnStatus {
  DRAFT
  SUBMITTED
}

model Firm {
  id                 String   @id @default(uuid())
  name               String
  legalName          String?
  companyNumber      String?
  vatNumber          String?
  address            String?
  city               String?
  county             String?
  postcode           String?
  country            String   @default("GB")
  currency           String   @default("GBP")
  contactEmail       String?
  contactPhone       String?
  vatScheme          String   @default("STANDARD")
  vatRegistered      Boolean  @default(true)
  financialYearStart Int      @default(4)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users           User[]
  customers       Customer[]
  suppliers       Supplier[]
  invoices        Invoice[]
  expenses        Expense[]
  payments        Payment[]
  vatRates        VatRate[]
  vatObligations  VatObligation[]
  vatReturns      VatReturn[]
  hmrcConnection  HmrcConnection?
  xeroConnection  XeroConnection?
  auditLogs       AuditLog[]

  @@map("firms")
}

model User {
  id           String   @id @default(uuid())
  firmId       String
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  firm      Firm       @relation(fields: [firmId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([firmId])
  @@map("users")
}

model Customer {
  id          String         @id @default(uuid())
  firmId      String
  name        String
  companyName String?
  email       String?
  phone       String?
  address     String?
  postcode    String?
  vatNumber   String?
  notes       String?
  status      CustomerStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  firm     Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([firmId])
  @@map("customers")
}

model Supplier {
  id          String         @id @default(uuid())
  firmId      String
  name        String
  companyName String?
  email       String?
  phone       String?
  address     String?
  postcode    String?
  vatNumber   String?
  notes       String?
  status      SupplierStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  firm     Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([firmId])
  @@map("suppliers")
}

model Invoice {
  id            String        @id @default(uuid())
  firmId        String
  customerId    String
  invoiceNumber String
  issueDate     DateTime
  dueDate       DateTime
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  vatTotal      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue    Decimal       @default(0) @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  firm     Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    InvoiceItem[]
  payments Payment[]

  @@unique([firmId, invoiceNumber])
  @@index([firmId])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  vatRate     Decimal  @db.Decimal(5, 2)
  vatAmount   Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Expense {
  id            String               @id @default(uuid())
  firmId        String
  supplierId    String?
  category      String
  description   String
  date          DateTime
  amount        Decimal              @db.Decimal(12, 2)
  vatRate       Decimal              @default(20.00) @db.Decimal(5, 2)
  vatAmount     Decimal              @default(0.00) @db.Decimal(12, 2)
  total         Decimal              @db.Decimal(12, 2)
  paymentStatus ExpensePaymentStatus @default(PAID)
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  firm     Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([firmId])
  @@index([supplierId])
  @@map("expenses")
}

model Payment {
  id            String        @id @default(uuid())
  firmId        String
  invoiceId     String?
  expenseId     String?
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("GBP")
  paymentDate   DateTime
  method        String        @default("BANK_TRANSFER")
  reference     String?
  status        PaymentStatus @default(SUCCEEDED)
  provider      String        @default("INTERNAL")
  providerTxId  String?
  metadata      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  firm    Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([firmId])
  @@index([invoiceId])
  @@index([expenseId])
  @@map("payments")
}

model VatRate {
  id        String   @id @default(uuid())
  firmId    String
  code      String
  name      String
  rate      Decimal  @db.Decimal(5, 2)
  isDefault Boolean  @default(false)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([firmId, code])
  @@index([firmId])
  @@map("vat_rates")
}

model VatObligation {
  id           String              @id @default(uuid())
  firmId       String
  startPeriod  DateTime
  endPeriod    DateTime
  dueDate      DateTime
  status       VatObligationStatus @default(OPEN)
  periodKey    String
  receivedDate DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([firmId, periodKey])
  @@index([firmId])
  @@map("vat_obligations")
}

model VatReturn {
  id                 String          @id @default(uuid())
  firmId             String
  periodKey          String
  startPeriod        DateTime
  endPeriod          DateTime
  box1               Decimal         @db.Decimal(12, 2)
  box2               Decimal         @db.Decimal(12, 2)
  box3               Decimal         @db.Decimal(12, 2)
  box4               Decimal         @db.Decimal(12, 2)
  box5               Decimal         @db.Decimal(12, 2)
  box6               Decimal         @db.Decimal(12, 2)
  box7               Decimal         @db.Decimal(12, 2)
  box8               Decimal         @db.Decimal(12, 2)
  box9               Decimal         @db.Decimal(12, 2)
  status             VatReturnStatus @default(DRAFT)
  submittedAt        DateTime?
  hmrcCorrelationId String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([firmId, periodKey])
  @@index([firmId])
  @@map("vat_returns")
}

model HmrcConnection {
  id           String    @id @default(uuid())
  firmId       String    @unique
  vrn          String
  isConnected  Boolean   @default(false)
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  lastSyncAt   DateTime?
  environment  String    @default("sandbox")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@map("hmrc_connections")
}

model XeroConnection {
  id           String    @id @default(uuid())
  firmId       String    @unique
  tenantId     String?
  tenantName   String?
  isConnected  Boolean   @default(false)
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  lastSyncAt   DateTime?
  environment  String    @default("demo")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@map("xero_connections")
}

model AuditLog {
  id        String   @id @default(uuid())
  firmId    String
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  String?
  ipAddress String?
  timestamp DateTime @default(now())

  firm Firm  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([firmId])
  @@index([userId])
  @@map("audit_logs")
}

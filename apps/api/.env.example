# Finora API (apps/api) Environment Variables

PORT=4000
NODE_ENV=production
DEMO_MODE=true
CORS_ORIGIN=https://finora-web.vercel.app
FRONTEND_URL=https://finora-web.vercel.app

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@hostname:5432/finora?sslmode=require

# JWT Secret
JWT_SECRET=your-secure-random-jwt-secret-min-32-characters
JWT_EXPIRES_IN=7d

# Integration Mode ('mock', 'sandbox', or 'production')
INTEGRATION_MODE=mock

# Third-Party Integrations (Optional)
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
HMRC_REDIRECT_URI=
HMRC_BASE_URL=https://test-api.service.hmrc.gov.uk
HMRC_ENVIRONMENT=sandbox
HMRC_ENCRYPTION_KEY=

XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=

PAYMENT_PROVIDER_KEY=

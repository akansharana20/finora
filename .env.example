# Finora Environment Configuration Template
# =============================================================================
# Backend API variables should be configured in the dedicated API deployment.
# Frontend variables should be configured in the dedicated web deployment.
# =============================================================================

# Server & Environment Setup
PORT=4000
NODE_ENV=development
DEMO_MODE=false
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL / Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finora_db?schema=public

# Authentication & Security
JWT_SECRET=replace-with-a-32-character-random-secret
JWT_EXPIRES_IN=7d

# Integration Mode: 'mock' for local offline testing, 'sandbox' for HMRC test API,
# or 'production' for live HMRC production credentials.
INTEGRATION_MODE=sandbox

# HMRC MTD VAT Integration
HMRC_CLIENT_ID=your_hmrc_application_client_id
HMRC_CLIENT_SECRET=your_hmrc_application_client_secret
HMRC_REDIRECT_URI=http://localhost:4000/api/hmrc/callback
HMRC_BASE_URL=https://test-api.service.hmrc.gov.uk
HMRC_AUTH_BASE_URL=https://test-www.tax.service.gov.uk
HMRC_ENVIRONMENT=sandbox
HMRC_ENCRYPTION_KEY=replace-with-a-32-character-secret-key
HMRC_VENDOR_INSTANCE_ID=your-stable-uuid-for-vendor-instance

# Xero Integration (Optional)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:4000/api/xero/callback

# Payment provider integration (Optional)
PAYMENT_PROVIDER_KEY=

# Frontend only
VITE_API_URL=http://localhost:4000/api
VITE_DEMO_MODE=false

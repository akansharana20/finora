# Finora Environment Configuration Template

# ==============================================================================
# BACKEND API ENVIRONMENT VARIABLES (apps/api)
# Configure these in Vercel for the backend API project (finora-api)
# ==============================================================================

# Server & Environment Setup
PORT=4000
NODE_ENV=production
DEMO_MODE=false
CORS_ORIGIN=https://finora-web-ecru.vercel.app
FRONTEND_URL=https://finora-web-ecru.vercel.app

# Database Connection (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@hostname:5432/finora?sslmode=require

# Authentication & Security
JWT_SECRET=your-secure-random-jwt-secret-min-32-characters
JWT_EXPIRES_IN=7d

# Integration Mode ('mock', 'sandbox', or 'production')
INTEGRATION_MODE=sandbox

# HMRC MTD VAT Integration
HMRC_CLIENT_ID=your_hmrc_application_client_id
HMRC_CLIENT_SECRET=your_hmrc_application_client_secret
HMRC_REDIRECT_URI=https://finora-api.vercel.app/api/hmrc/callback
HMRC_BASE_URL=https://test-api.service.hmrc.gov.uk
HMRC_ENVIRONMENT=sandbox
HMRC_ENCRYPTION_KEY=your-32-character-secret-key-for-aes-256-gcm

# Xero Integration (Optional)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=

# Payment Provider Integration (Optional)
PAYMENT_PROVIDER_KEY=


# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (apps/web)
# Configure these in Vercel for the frontend web application project (finora-web)
# ==============================================================================

# Frontend-Only Demo Mode (set to false for production live backend communication)
VITE_DEMO_MODE=false

# Public API Base URL for Vite
VITE_API_URL=https://finora-api.vercel.app/api

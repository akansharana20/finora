# Finora Environment Configuration Template

# ==============================================================================
# BACKEND API ENVIRONMENT VARIABLES (apps/api)
# Configure these in Vercel for the backend API project
# ==============================================================================

# Server & Environment Setup
PORT=4000
NODE_ENV=production
DEMO_MODE=true
CORS_ORIGIN=https://finora-web.vercel.app
FRONTEND_URL=https://finora-web.vercel.app

# Database Connection (PostgreSQL / Neon / Supabase)
DATABASE_URL=postgresql://user:password@hostname:5432/finora?sslmode=require

# Authentication & Security
JWT_SECRET=your-secure-random-jwt-secret-min-32-characters
JWT_EXPIRES_IN=7d

# Integration Mode ('mock', 'sandbox', or 'production')
INTEGRATION_MODE=mock

# HMRC MTD VAT Integration (Optional)
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
HMRC_REDIRECT_URI=
HMRC_BASE_URL=https://test-api.service.hmrc.gov.uk
HMRC_ENVIRONMENT=sandbox
HMRC_ENCRYPTION_KEY=

# Xero Integration (Optional)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=

# Payment Provider Integration (Optional)
PAYMENT_PROVIDER_KEY=


# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (apps/web)
# Configure these in Vercel for the frontend web application project
# ==============================================================================

# Public API Base URL for Vite (Build-time variable)
VITE_API_URL=https://finora-api.vercel.app/api

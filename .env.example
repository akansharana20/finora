# Finora Environment Configuration Template

# Server Configuration
PORT=4000
NODE_ENV=production
DEMO_MODE=false
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL / Neon)
DATABASE_URL=

# Authentication & Security
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Integration Mode ('mock', 'sandbox', or 'production')
INTEGRATION_MODE=mock

# HMRC MTD VAT Integration
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
HMRC_REDIRECT_URI=
HMRC_BASE_URL=https://test-api.service.hmrc.gov.uk
HMRC_ENVIRONMENT=sandbox
HMRC_ENCRYPTION_KEY=

# Xero Integration
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=

# Payment Provider Integration
PAYMENT_PROVIDER_KEY=

# Frontend API Base URL (used by Vite at build time)
VITE_API_URL=http://localhost:4000/api
